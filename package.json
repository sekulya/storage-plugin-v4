{
  "name": "@storage/plugin",
  "version": "0.1.0",
  "private": true,
  "description": "RFID warehouse: zones and shelves, RFID-tagged stock by piece, box or drum, counts and movements",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @storage/api build && pnpm --filter @storage/ui build",
    "db:generate": "pnpm --filter @storage/api db:generate",
    "db:check": "pnpm --filter @storage/api db:check",
    "db:migrate": "pnpm --filter @storage/api db:migrate",
    "check:generated": "node tools/check-generated.ts",
    "check:rls": "bash tools/check-rls.sh",
    "dev:api": "pnpm --filter @storage/api dev",
    "dev:ui": "pnpm --filter @storage/ui dev",
    "image:context": "pnpm build && rm -rf .runtime && pnpm --filter @storage/api deploy --prod .runtime"
  },
  "devDependencies": {
    "@erxes/lint": "0.1.3",
    "@types/node": "^26.6.6",
    "knip": "^6.45.1",
    "react-doctor": "0.9.23",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.5.2"
}
